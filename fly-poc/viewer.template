<!doctype html><html lang="th"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FlyVis · ห้องทดสอบกล้อง</title>
<style>*{box-sizing:border-box}body{max-width:940px;margin:5vh auto;padding:22px;background:#edf0eb;color:#182720;font:16px system-ui}h1{font-size:clamp(25px,4vw,44px);margin:.4em 0}main{display:grid;grid-template-columns:2fr 1fr;gap:16px}figure{margin:0}figcaption{padding:8px 0}img,canvas{width:100%;aspect-ratio:5/3;background:#1e302a;border-radius:5px}img{image-rendering:pixelated}button,select{font:inherit;padding:7px;margin:5px 4px 10px 0}input{width:100%}output{font-family:monospace}@media(max-width:600px){main{grid-template-columns:1fr}}</style>
<h1>กล้องหน้าของโดรนจำลอง</h1><p>FlyVis · ภาพขาวดำ 80 × 48 พิกเซล · 10 เฟรมต่อวินาที</p>
<select id="scene" aria-label="ฉาก"><option>ทางโล่ง</option><option>กล่องเยื้องขวา</option><option>กล่องเยื้องซ้าย</option><option>กำแพงปิดทาง</option><option selected>กล่องเยื้องขวา · สีอ่อน (หลังแก้)</option><option>กล่องเยื้องขวา · สีอ่อน (ก่อนแก้)</option><option>กล้องค้างขณะเคลื่อนที่</option><option>กล้องเสนอให้ไปต่อ · เซนเซอร์หน้าเจอกำแพง</option></select>
<main><figure><img id="eye" alt="ภาพจากกล้องเสมือน"><figcaption>ภาพที่ป้อนให้ระบบการมองเห็น</figcaption></figure><figure><canvas id="map" width="400" height="240"></canvas><figcaption>มุมบน · เส้นสีเขียวคือเส้นทางบิน</figcaption></figure></main>
<button id="play">เล่น</button><output id="status"></output><input id="seek" type="range" min="0" value="0" aria-label="เลือกเฟรม">
<script>
const runs=REPLAY_DATA, ctx=map.getContext('2d');
let timer=null;
function pause(){clearInterval(timer);timer=null;play.textContent='เล่น'}
function draw(){const run=runs[scene.selectedIndex],i=Number(seek.value),f=run.frames[i];eye.src='data:image/png;base64,'+f[3];document.getElementById('status').textContent=(i/10).toFixed(1)+' s · Model '+f[2]+(f.length>4?' · Planner '+f[4]+' · เป้าหมาย (ข้าง, หน้า) '+f[5]+', '+f[6]+' m/s · ความเร็วลำ '+f[7]+' m/s · อายุภาพ '+f[8]+' s':'')+(i===run.frames.length-1?' · '+run.result:'');ctx.fillStyle='#20332d';ctx.fillRect(0,0,400,240);const scale=Math.min(30,200/(run.finish||6.8)),X=x=>200+scale*x,Y=y=>222-scale*y;ctx.fillStyle='#c19363';for(const [shape] of run.obstacles||(run.box?[[run.box]]:[])){let [l,r,a,b]=shape;ctx.fillRect(X(l),Y(b),(r-l)*scale,(b-a)*scale)}ctx.fillStyle='#9ba99c';ctx.fillRect(X(-3.5),Y(run.finish||6.8),7*scale,1);ctx.strokeStyle='#74dfad';ctx.lineWidth=3;ctx.beginPath();run.frames.slice(0,i+1).forEach(([x,y],j)=>j?ctx.lineTo(X(x),Y(y)):ctx.moveTo(X(x),Y(y)));ctx.stroke();ctx.fillStyle='#daf3e5';ctx.beginPath();ctx.arc(X(f[0]),Y(f[1]),.24*scale,0,2*Math.PI);ctx.fill();if(i===run.frames.length-1 && run.result==='Collision' && run.end_x!=null){ctx.fillStyle='#ff705e';ctx.beginPath();ctx.arc(X(run.end_x),Y(run.end_y),.24*scale,0,2*Math.PI);ctx.fill()}}
function reset(){pause();seek.max=runs[scene.selectedIndex].frames.length-1;seek.value=0;draw()}
scene.onchange=reset;seek.oninput=draw;play.onclick=()=>{if(timer)return pause();if(seek.value===seek.max)seek.value=0;play.textContent='พัก';timer=setInterval(()=>{draw();if(+seek.value>=+seek.max)pause();else seek.value=+seek.value+1},100)};reset();
</script></html>
